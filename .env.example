# ============================================================
# READ-ON-ME 운영 필수 환경변수
# 이 파일을 복사해 .env 로 저장한 뒤 실제 값으로 교체하세요.
# 실제 secret 값은 절대 커밋하지 마세요.
# ============================================================

# ── DB (PostgreSQL) ──────────────────────────────────────────
POSTGRES_DB=readonme
POSTGRES_USER=readonme
POSTGRES_PASSWORD=<강력한 DB 비밀번호>               # 필수 | 기본값 없음

# Spring Boot가 사용하는 JDBC URL (도커 컴포즈 내부망)
SPRING_DB_URL=jdbc:postgresql://postgres:5432/readonme

# FastAPI가 사용하는 asyncpg DSN (도커 컴포즈 내부망)
AI_DATABASE_URL=postgresql+asyncpg://readonme:<DB 비밀번호>@postgres:5432/readonme

# ── 보안 ────────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열
# 생성 예: openssl rand -base64 48
JWT_SECRET=<최소 32자 랜덤 문자열>                   # 필수 | 기본값 없음
INTERNAL_API_TOKEN=<최소 32자 랜덤 문자열>            # 필수 | 기본값 없음

# ── 외부 API ────────────────────────────────────────────────
KAKAO_API_KEY=<Kakao Developers에서 발급한 REST API 키>  # 필수
GEMINI_API_KEY=<Google AI Studio에서 발급한 API 키>       # 필수
# 선택: Gemini 재정렬이 429/5xx/타임아웃일 때만 Groq으로 재시도
GROQ_API_KEY=                                           # 없으면 기존 규칙 기반 대체 결과 사용

# ── 서비스 URL ───────────────────────────────────────────────
CORS_URL=https://your-domain.com                      # 필수 | 운영 프론트엔드 URL
SPRING_BOOT_URL=http://backend:8080                   # 도커 컴포즈 내부 기본값 사용 가능
AI_BASE_URL=http://ai:8000                            # 도커 컴포즈 내부 기본값 사용 가능

# ── 기타 ────────────────────────────────────────────────────
APP_ENV=prod                                          # FastAPI prod 검증 활성화
LIBRARY_BIGDATA_API_KEY=<도서관 정보나루 API 키>       # 선택
