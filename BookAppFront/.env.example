# Local development can leave this empty to use the Expo development host.
# Web/native release builds require the public HTTPS Spring API URL.
# Example: EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_URL=

# Optional local device override, used only without EXPO_PUBLIC_API_URL in dev.
# EXPO_PUBLIC_API_HOST=192.168.0.10
